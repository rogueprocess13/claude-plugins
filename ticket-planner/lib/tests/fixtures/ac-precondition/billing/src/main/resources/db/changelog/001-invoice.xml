<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog">
    <!-- A draft had <constraints nullable="false"/> on reference;
         this comment gives no fact. -->
    <changeSet id="001" author="billing">
        <createTable tableName="invoice">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column
                name="due_date"
                type="date">
                <constraints
                    nullable="false"
                    />
            </column>
            <column name="paid_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
            <column name="number" type="int"/>
            <column name="status" type="varchar(16)"/>
            <column name="reminder_count" type="int"/>
            <column name="customer_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <rollback>
            <addNotNullConstraint tableName="invoice" columnName="note"
                columnDataType="varchar(200)"/>
            <dropTable tableName="invoice"/>
        </rollback>
    </changeSet>
    <changeSet id="002" author="billing">
        <addColumn tableName="invoice">
            <column name="reference" type="varchar(40)">
                <!-- <constraints nullable="false"/> -->
            </column>
            <column name="note"
                type="varchar(200)">
                <constraints nullable="true"/>
            </column>
            <column name="priority" type="varchar(8)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
